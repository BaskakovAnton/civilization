{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization.local/schema/place.schema.json",
  "title": "Place",
  "type": "object",
  "required": ["id", "label_ru", "epoch_ids", "confidence", "source_ids"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "label_ru": { "type": "string" },
    "epoch_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["literary", "disputed", "anchored", "firm"]
    },
    "note_ru": { "type": "string" },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "person_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "citation.schema.json" }
    }
  }
}
